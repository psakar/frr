@@ -0,0 +1,17 @@
+!
+interface lo
+ ip address 10.0.0.1/32
+!
+interface r1-eth0
+ ip address 192.0.2.1/24
+!
+router bgp 65000
+ bgp router-id 10.0.0.1
+ no bgp default ipv4-unicast
+ neighbor 192.0.2.2 remote-as 65000
+ !
+ address-family l2vpn evpn
+  neighbor 192.0.2.2 activate
+  advertise-all-vni
+ exit-address-family
+!
